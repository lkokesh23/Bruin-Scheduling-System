<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Create Account</title>
    <style>
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2
        {
            margin-top: 16px;
            margin-bottom: 4px;
        }

        h2.midtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        h3.subtitle
        {
            margin-top: 0;
            margin-bottom: 0;
        }

        button
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }

        input[type="email"]
        {
            margin-top: 4px;
            margin-bottom: 4px;
        }

        input[type="password"]
        {
            margin-top: 4px;
            margin-bottom: 4px;
        }

        input[type="password2"]
        {
            margin-top: 4px;
            margin-bottom: 4px;
        }

        input[type="checkbox"]
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }
    </style>
</head>

<body>

    <div class="header">
            <h3 class="subtitle">George Fox University</h3>
            <h2 class="midtitle">Bruin Scheduling System</h2>
            <h1>Create Account</h1>
        </div>
        
    <form id="accCreateForm" method="POST" action="/create_account">
        
        <div class="firstName">
            <label for="firstNameInput"><h2>Enter your first name</h2></label>
            <input 
                type="text"
                id="firstNameInput"
                name="firstName"
                placeholder="Enter first name"
                required>
        </div>

        <div class="lastName">
            <label for="lastNameInput"><h2>Enter your last name</h2></label>
            <input 
                type="text"
                id="lastNameInput"
                name="lastName"
                placeholder="Enter last name"
                required>
        </div>

        <div class="email">
            <!-- User enters their credentials
            Enter the user email
            Enter the user password -->
            <label for="emailInput"><h2>Enter your George Fox Email</h2></label>
            <input 
                type="email"
                id="emailInput"
                name="email"
                placeholder="Enter email"
                required>
        </div>

        <div class="password">
            <label for="passwordInput"><h2>Create a password</h2></label>
            <input 
                type="password"
                id="passwordInput"
                name="password"
                placeholder="Enter password"
                required>
        </div>

        <div class="show-hide-pw">
            <input type="checkbox" id="togglePassword"/>
            <label for="togglePassword">Show Password</label>
        </div>

        <div class="password">
            <label for="passwordInput2"><h2>Type your password again</h2></label>
            <input
                type="password"
                id="passwordInput2"
                name="confirmPassword"
                placeholder="In case you spelled it wrong"
                required>
        </div>
        
        <div class="show-hide-pw2">
            <input type="checkbox" id="togglePassword2"/>
            <label for="togglePassword2">Show Password</label>
        </div>

        <br><br>

        <div class="buttons">
            <!-- Create account button goes to the create account page.
            Login button redirects to home page.
            Login will eventually be redirected after it communicates with the server. -->
            <button type="button" onclick="window.location.href='/login'">Login</button>
            <button type="submit">Create Account</button>
        </div>

        <div class="forgot-pw">
            <button type="button" onclick="window.location.href='/forgot_password'">Forgot Password?</button>
        </div>
    </form>

    <!-- I had ai generate the view/hide password thing because I was lazy -->
    <script>
        // the form
        const accCreateForm = document.querySelector("#accCreateForm")

        // password field 1
        const passwordInput = document.querySelector("#passwordInput");
        const toggleCheckbox = document.querySelector("#togglePassword");

        // password field 2
        const passwordInput2 = document.querySelector("#passwordInput2");
        const toggleCheckbox2 = document.querySelector("#togglePassword2");
        
        // toggle password for first field
        toggleCheckbox.addEventListener("change", function () {
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
            } else {
                passwordInput.type = "password";
            }
        });

        // toggle password for second field
        toggleCheckbox2.addEventListener("change", function () {
            if (passwordInput2.type === "password") {
                passwordInput2.type = "text";
            } else {
                passwordInput2.type = "password";
            }
        });

    </script>

</body>
</html>