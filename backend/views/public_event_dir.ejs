<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Public Events Directory</title>

    <style>
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2.midtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        h3.subtitle
        {
            margin-top: 0;
            margin-bottom: 0;
        }

        button
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h3 class="subtitle">George Fox University</h3>
        <h2 class="midtitle">Bruin Scheduling System</h2>
        <h1>Public Events Directory</h1>
    </div>

    <form>
        <label for="category">Event Category: </label>
        <select id="category" name="category">
            <option value="" disabled selected hidden>Select category</option>
            <option value="club">Club</option>
            <option value="study-group">Study Group</option>
            <option value="help-session">Help Session</option>
            <option value="office-hours">Office Hours</option>
            <option value="sport-practice">Sports Practice</option>
            <option value="sport-event">Sporting Event</option>
            <option value="event-activity">Event/Activity</option>
            <option value="misc">Miscellaneous/Other</option>
        </select>

        <span>| Extra Info/Details: </span>

        <!-- Type in other info like class codes or something -->
        <input type="details" id="extra-info" placeholder="Enter info here" required>
    </form>

    <br><br>
    Add Public Event to Personal Calendar: <button>Add Event</button>

    <br><br>
    <button onclick="window.location.href='/'">Take Me Home</button>

</body>
</html>