<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Login</title>
    <style>
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2
        {
            margin-top: 16px;
            margin-bottom: 4px;
        }

        h2.midtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        h3.subtitle
        {
            margin-top: 0;
            margin-bottom: 0;
        }

        button
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }

        input[type="email"]
        {
            margin-top: 4px;
            margin-bottom: 4px;
        }

        input[type="password"]
        {
            margin-top: 4px;
            margin-bottom: 4px;
        }

        input[type="checkbox"]
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }
    </style>
</head>

<body>

    <form id="loginForm" method="POST" action="/login">
        <div class="header">
            <h3 class="subtitle">George Fox University</h3>
            <h2 class="midtitle">Bruin Scheduling System</h2>
            <h1>Login</h1>
        </div>
        
        <div class="email">
            <!-- User enters their credentials
            Enter the user email
            Enter the user password -->
            <label for="emailInput"><h2>Enter your George Fox Email</h2></label>
            <input 
                type="email"
                id="emailInput"
                name="email"
                placeholder="Enter email"
                required>
        </div>

        <div class="password">
            <label for="passwordInput"><h2>Enter password</h2></label>
            <input 
                type="password"
                id="passwordInput"
                name="password"
                placeholder="Enter password"
                required>
        </div>

        <div class="show-hide-pw">
            <input type="checkbox" id="togglePassword"/>
            <label for="togglePassword">Show Password</label>
        </div>

        <br><br>

        <div class="buttons">
            <!-- Create account button goes to the create account page.
            Login button redirects to home page.
            Login will eventually be redirected after it communicates with the server. -->
            <button type="submit">Login</button>
            <button type="button" onclick="window.location.href='/create_account'">Create Account</button>
        </div>

        <div class="forgot-pw">
            <button onclick="window.location.href='/forgot_password'">Forgot Password?</button>
        </div>
    </form>

    <!-- I had ai generate the view/hide password thing because I was lazy -->
    <script>
        const passwordInput = document.querySelector("#passwordInput");
        const toggleCheckbox = document.querySelector("#togglePassword");

        toggleCheckbox.addEventListener("change", function () {
            passwordInput.type = toggleCheckbox.checked ? "text" : "password";
        });
        
    </script>
    <!-- end of ai generated content -->

</body>
</html>