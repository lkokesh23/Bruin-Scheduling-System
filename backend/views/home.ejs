<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Home</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@event-calendar/build/dist/event-calendar.min.css" />
	  <style>
		body { font-family: system-ui, sans-serif; padding: 20px; }
		#ec { max-width: 1100px; margin: 0 auto; }

		.header
		{
			text-align: center;
			color: #CFB53B;
			background-color: #000080;
		}
		
		button
		{
			border-radius: 8px;
			background-color: #ADD8E6;
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
			border: 1px solid transparent;
			cursor: pointer;
			color: #000000;
			font-family: inherit;
		}
		
		button a
		{
			text-decoration: none;
			color: inherit;
			display: block;
		}
		
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2.subtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        button
        {
            margin-top: 16px;
            margin-right: 16px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2 class="subtitle">George Fox University</h2>
        <h1>Bruin Scheduling System</h1>
    </div>

    <div class="calendar">
        <div class="month-year"><button><h2>November</h2></button></div>
        
        <div class="calendar-grid">
            <div class="day-name">Monday</div>
            <div class="day-name">Tuesday</div>
            <div class="day-name">Wednesday</div>
            <div class="day-name">Thursday</div>
            <div class="day-name">Friday</div>
            <div class="day-name">Saturday</div>
            <div class="day-name">Sunday</div>
        </div>

    </div>
    
    <!-- The buttons are linked to go to their corresponding pages. -->
    
    <button><a href="/add-event/<%= account_id %>">Add Event</a></button>

    <button><a href="/public-events">Public Events Directory</a></button>

    <button><a href="/login">Logout</a></button>

    <!-- Insert the calendar with all your stuff displayed here. -->
    
	<div id="ec"></div>

  <!-- EventCalendar UMD Bundle (includes all views + Interaction plugin) -->
  <script src="https://cdn.jsdelivr.net/npm/@event-calendar/build/dist/event-calendar.min.js"></script>

  <script>
	// Safely inject EJS server variables into client JS
	const currentAccountId = <%- JSON.stringify(account_id) %>;

	const ec = EventCalendar.create(document.getElementById('ec'), {
	  view: 'timeGridWeek',
	  headerToolbar: {
		start: 'prev,next today',
		center: 'title',
		end: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
	  },
	  editable: false,
	  eventStartEditable: false,
	  eventDurationEditable: false,
	  selectable: false,
	  lazyFetching: true, // Caches fetched date ranges automatically
	  eventSources: [
		{
		  url: '/api/events',
		  extraParams: {
			userId: currentAccountId
		  }
		}
	  ],
	  eventClick(info) {
		alert(`Clicked: ${info.event.title}`);
	  }
	});
  </script>
    

</body>
</html>