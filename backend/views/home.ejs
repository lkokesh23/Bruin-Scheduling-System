            <div class="day-name">Sunday</div>
        </div>

    </div>
    
    <!-- The buttons are linked to go to their corresponding pages. -->
    
    <button onclick="window.location.href='/add_event'">Add Event</button>

    <button onclick="window.location.href='/public_event_dir'">Public Events Directory</button>

    <button onclick="window.location.href='/login'">Logout</button>

