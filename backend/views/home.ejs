<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Home</title>

    <style>
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2.subtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        button
        {
            margin-top: 16px;
            margin-right: 16px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2 class="subtitle">George Fox University</h2>
