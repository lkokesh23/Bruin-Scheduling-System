<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bru-Sche-Sys | Add Event</title>

    <style>
        h1
        {
            margin-top: 16px;
            margin-bottom: 16px;
        }

        h2
        {
            margin-top: 16px;
            margin-bottom: 8px;
        }

        h3
        {
            margin-top: 8px;
            margin-bottom: 8px;
        }

        h2.midtitle
        {
            margin-top: 0;
            margin-bottom: 16px;
        }

        h3.subtitle
        {
            margin-top: 0;
            margin-bottom: 0;
        }

        .email, .password
        {
        margin-bottom: 8px;
        }

        button
        {
            margin-top: 4px;
            margin-bottom: 8px;
        }
    </style>
</head>

<body>
    <div class="header">
            <h3 class="subtitle">George Fox University</h3>
            <h2 class="midtitle">Bruin Scheduling System</h2>
            <h1>Add Event</h1>
        </div>

    <br><br>

    <div class="add-event">
		<form action="/add-event" method="POST">
			<input type="hidden" name="creator_id" value="<%= account_id %>" />

			<div class="form-group">
			<label for="title">Event Title</label>
			<input type="text" id="title" name="title" placeholder="Event Title" required />
			</div>

			<div class="form-group">
			<label for="date">Date</label>
			<input type="date" id="date" name="date" required />
			</div>

			<div class="time-row">
			<div class="form-group">
			  <label for="startTime">Start Time</label>
			  <input type="time" id="startTime" name="startTime" required />
			</div>

			<div class="form-group">
			  <label for="endTime">End Time</label>
			  <input type="time" id="endTime" name="endTime" required />
			</div>
			</div>

			<div class="form-group">
			<label for="location">Location</label>
			<input type="text" id="location" name="location" placeholder="Location" required />
			</div>

			<button type="submit">Add Event to Calendar</button>
		</form>
    </div>
    
    <br><br>
    <button><a href="/<%= account_id %>">Take Me Home</a></button>

</body>
</html>